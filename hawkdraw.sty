        }
            \g_hawkdraw_path_last_point_fp
            \l_hawkdraw_path_grid_corner_fp
    } {
        \draw_path_grid:eeVV {
            \clist_item:Nn \l_hawkdraw_path_grid_step_clist { 1 }
        } {
            \clist_item:Nn \l_hawkdraw_path_grid_step_clist { 1 }
        }
            \g_hawkdraw_path_last_point_fp
            \l_hawkdraw_path_grid_corner_fp
    }
    \fp_gset_eq:NN \g_hawkdraw_path_last_point_fp \l_hawkdraw_path_grid_corner_fp
    \tl_trim_spaces_apply:nN {#3} \__hawkdraw_continue_path:n
}

