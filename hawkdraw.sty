        \draw_point:n { #1 * #3 + #2 * #5 , #1 * #4 + #2 * #6 }
    }
    \cs_set:Npn \__draw_point_interpolate_curve_auxvii:nnnnnnnn #1#2#3#4#5#6#7#8 {
        \__draw_point_interpolate_curve_auxviii:eeeenn
            { \fp_eval:n { #1 * #3 + #2 * #5 } }
            { \fp_eval:n { #1 * #4 + #2 * #6 } }
            { \fp_eval:n { #1 * #5 + #2 * #7 } }
